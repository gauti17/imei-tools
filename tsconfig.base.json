{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true,
    "isolatedModules": true,
